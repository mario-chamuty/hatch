{
  "name": "test_local_app",
  "description": "Test app with local packages",

  "sdk": {
    "flutter": "3.35.2",
    "dart": ">=3.5.0 <4.0.0"
  },

  // Dependencies
  "require": {
    "cupertino_icons": "^1.0.2",
    "provider": "^6.0.0",
    "http": "^1.5.0",
    "my_local_package": "any"
  },

  // Local package mappings
  "local-packages": {
    "my_local_package": "../my_package"
  },

  // Version overrides
  "overrides": {
    "path": "1.9.0 as 1.9.5",  // Force specific version
    "collection": "path:../collection_fork as 1.19.0"  // Use local fork
  }
}