{
  "name": "test_dependency_conflicts",
  "description": "Test validation of conflicting dependency sources",
  "sdk": {
    "flutter": "3.24.2",
    "dart": ">=3.5.0 <4.0.0"
  },
  "require": {
    "http": "^0.13.0",
    "local_package": {
      "version": "any",
      "path": "../local_package"
    },
    "git_package": {
      "version": "any",
      "git": "https://github.com/example/package.git",
      "ref": "main"
    },
    "private_package": {
      "version": "^1.0.0",
      "nest": "company-registry"
    },
    "conflict_git_path": {
      "version": "any",
      "git": "https://github.com/example/package.git",
      "path": "../local"
    },
    "conflict_git_nest": {
      "version": "any",
      "git": "https://github.com/example/package.git",
      "nest": "company-registry"
    },
    "conflict_all": {
      "version": "any",
      "git": "https://github.com/example/package.git",
      "path": "../local",
      "nest": "company-registry"
    },
    "invalid_ref": {
      "version": "^1.0.0",
      "ref": "main"
    }
  }
}